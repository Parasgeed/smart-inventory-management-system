# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/inventory-management

# JWT Authentication Configuration
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated, e.g. https://app.example.com,http://localhost:5173)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
